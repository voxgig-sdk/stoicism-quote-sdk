# Entity: stoic_quote

main: kit: entity: stoic_quote: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "The author of the stoicism quote"
      type: "`$STRING`"
    }
    {
      name: "quote"
      req: true
      short: "The stoicism quote text"
      type: "`$STRING`"
    }
  ]

  name: "stoic_quote"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/stoic-quote"
          parts: [
            "stoic-quote"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
